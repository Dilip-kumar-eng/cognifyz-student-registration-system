<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Management</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">

        <div class="logo">
            Student Management
        </div>

        <div class="nav-links">
            <a href="#registration">Register</a>
            <a href="#home">Home</a>
            <a href="#features">Features</a>
        </div>

    </nav>

    <!-- Hero Section -->
    <section class="hero" id="home">

        <div class="hero-content">

            <h1>Student Registration System</h1>

            <p>
                Register students and manage their information
                easily using our simple web application.
            </p>

            <a href="#registration" class="hero-btn">
                Register Student
            </a>

        </div>

    </section>

    <!-- Registration Section -->
    <section class="registration" id="registration">

        <div class="form-card">

            <h2>Register New Student</h2>

            <form id="studentForm">

                <!-- Student Name -->
                <label>Student Name</label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter student name"
                    required
                >


                <!-- Email -->
                <label>Email</label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter email"
                    required
                >

                <!-- Course -->
                <label>Course</label>

                <select name="course">

                    <option value="B.Tech CSE">
                        B.Tech CSE
                    </option>

                    <option value="BCA">
                        BCA
                    </option>

                    <option value="MCA">
                        MCA
                    </option>

                </select>
                <!-- Password -->
                <label>Password</label>

                <input
                    type="password"
                    name="password"
                    placeholder="Enter password"
                    minlength="8"
                    required
                >

                <p id="passwordMessage"></p>


                <!-- Submit Button -->
                <button
                    type="submit"
                    class="btn btn-primary w-100"
                >
                    Register Student
                </button>

            </form>

        </div>

    </section>

    <!-- Features Section -->
    <section class="features" id="features">

        <h2>Why Use Our System?</h2>

        <div class="feature-container">

            <div class="feature-card shadow-sm p-4">

                <h3>📝 Easy Registration</h3>

                <p>
                    Register students using a simple and
                    user-friendly form.
                </p>

            </div>
            <div class="feature-card shadow-sm p-4">

                <h3>🔒 Validation</h3>

                <p>
                    Student information is validated before
                    being processed by the server.
                </p>

            </div>


            <div class="feature-card shadow-sm p-4">

                <h3>📊 Student Management</h3>

                <p>
                    View registered students from a separate
                    student management page.
                </p>

            </div>

        </div>

    </section>
    <!-- Footer -->
    <footer>

        <p>
            © 2026 Student Management System
        </p>

    </footer>


    <!-- Inline JavaScript -->
    <script>

        const form = document.querySelector("#studentForm");

        form.addEventListener("submit", async function(event) {

            event.preventDefault();


            // Get form values
            const name =
                document.querySelector('[name="name"]').value.trim();

            const email =
                document.querySelector('[name="email"]').value.trim();

            const password =
                document.querySelector('[name="password"]').value;

            const course =
                document.querySelector('[name="course"]').value;

            const passwordMessage =
                document.querySelector("#passwordMessage");


            // Password validation
            const hasUppercase = /[A-Z]/.test(password);
            const hasLowercase = /[a-z]/.test(password);
            const hasNumber = /[0-9]/.test(password);

            if (
                password.length < 8 ||
                !hasUppercase ||
                !hasLowercase ||
                !hasNumber
            ) {

                passwordMessage.textContent =
                    "Password must contain 8 characters, uppercase, lowercase and number.";

                return;
            }

            passwordMessage.textContent = "";


            // Name validation
            if (name.length < 3) {

                alert("❌ Name must be at least 3 characters!");

                return;
            }


            // Email validation
            if (!email.includes("@")) {

                alert("❌ Enter a valid email!");

                return;
            }
            // Client-side validation successful
            alert("✅ Client-side validation successful!");


            // Send data to REST API
            try {

                const response = await fetch("/api/students", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        name,
                        email,
                        course
                    })

                });
                const data = await response.json();
                // Server error
                if (!response.ok) {

                    alert("❌ " + data.message);

                    return;
                }
                // Success
                alert("✅ Student registered successfully!");

                form.reset();
                // Open student management page
                window.location.href = "/students";

            } catch (error) {

                console.error("Error:", error);

                alert("❌ Something went wrong!");

            }

        });
        // Smooth Navigation
        const navLinks =
            document.querySelectorAll(".nav-links a");

        navLinks.forEach(link => {

            link.addEventListener("click", function(event) {

                const targetId =
                    this.getAttribute("href");

                const targetSection =
                    document.querySelector(targetId);
                if (targetSection) {

                    event.preventDefault();

                    targetSection.scrollIntoView({
                        behavior: "smooth"
                    });
                }
            });
        });

    </script>
</body>
</html>